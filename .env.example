# Inget här krävs för demon eller för manuell användning.

# Publik adress (används för bankens återhopp). Standard: härleds från anropet.
# APP_URL=https://ryms.example.se

# Var databasen och sparade bilder ligger. Standard: ./data
# RYMS_DATA_DIR=/var/lib/ryms

# 32 slumpade byte, base64. Krävs i produktion för att kryptera banksessioner.
# Skapa med: openssl rand -base64 32
# RYMS_ENCRYPTION_KEY=

# Bildanalys (foto/skärmbild). Utan nyckel fungerar egen inmatning som vanligt.
# ANTHROPIC_API_KEY=
# RYMS_VISION_MODEL=claude-opus-5-5

# Bankkoppling via Enable Banking (endast kontoinformation).
# BANK_ENV=sandbox            # eller production
# ENABLEBANKING_APP_ID=
# ENABLEBANKING_PRIVATE_KEY_PATH=/secrets/enablebanking.pem

# Länken till appen i App Store (knappen på landningssidan). Tills den är satt leder knappen ingenstans.
# NEXT_PUBLIC_APP_STORE_URL=https://apps.apple.com/se/app/...
